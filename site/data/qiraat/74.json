ā","4":"ʾiḏā","5":"ʾiḏā","6":"ʾiḏā","7":"ʾiḏā","8":"ʾiḏā","12":"ʾiḏā","13":"ʾiḏā"}],["أَدۡبَرَ","ʾadbara",{"2":"dabara","3":"dabara","4":"dabara","5":"dabara","6":"dabara","7":"dabara","8":"dabara","12":"dabara","13":"dabara"}]],[["وَٱلصُّبۡحِ","wa-ṣ-ṣubḥi"],["إِذَآ","ʾiḏā"],["أَسۡفَرَ","ʾasfara"]],[["إِنَّهَا","ʾinnahā"],["لَإِحۡدَى","la-ʾiḥda"],["ٱلۡكُبَرِ","l-kubari"]],[["نَذِیرࣰا","naḏīran"],["لِّلۡبَشَرِ","li-l-bašari"]],[["لِمَن","li-man"],["شَآءَ","šāʾa"],["مِنكُمۡ","minkum"],["أَن","ʾan"],["یَتَقَدَّمَ","yataqaddama"],["أَوۡ","ʾau"],["یَتَأَخَّرَ","yataʾaḫḫara"]],[["كُلُّ","kullu"],["نَفۡسِۭ","nafsin"],["بِمَا","bi-mā"],["كَسَبَتۡ","kasabat"],["رَهِینَةٌ","rahīnatun"]],[["إِلَّآ","ʾillā"],["أَصۡحَٰبَ","ʾaṣḥāba"],["ٱلۡیَمِینِ","l-yamīni"]],[["فِی","fī"],["جَنَّٰتࣲ","ǧannātin"],["یَتَسَآءَلُونَ","yatasāʾalūna"]],[["عَنِ","ʿani"],["ٱلۡمُجۡرِمِینَ","l-muǧrimīna"]],[["مَا","mā"],["سَلَكَكُمۡ","salakakum"],["فِی","fī"],["سَقَرَ","saqara"]],[["قَالُوا۟","qālū"],["لَمۡ","lam"],["نَكُ","naku"],["مِنَ","mina"],["ٱلۡمُصَلِّینَ","l-muṣallīna"]],[["وَلَمۡ","wa-lam"],["نَكُ","naku"],["نُطۡعِمُ","nuṭʿimu"],["ٱلۡمِسۡكِینَ","l-miskīna"]],[["وَكُنَّا","wa-kunnā"],["نَخُوضُ","naḫūḍu"],["مَعَ","maʿa"],["ٱلۡخَآىِٕضِینَ","l-ḫāʾiḍīna"]],[["وَكُنَّا","wa-kunnā"],["نُكَذِّبُ","nukaḏḏibu"],["بِیَوۡمِ","bi-yaumi"],["ٱلدِّینِ","d-dīni"]],[["حَتَّىٰٓ","ḥattā"],["أَتَىٰنَا","ʾatāna"],["ٱلۡیَقِینُ","l-yaqīnu"]],[["فَمَا","fa-mā"],["تَنفَعُهُمۡ","tanfaʿuhum"],["شَفَٰعَةُ","šafāʿatu"],["ٱلشَّٰفِعِینَ","š-šāfiʿīna"]],[["فَمَا","fa-mā"],["لَهُمۡ","lahum"],["عَنِ","ʿani"],["ٱلتَّذۡكِرَةِ","t-taḏkirati"],["مُعۡرِضِینَ","muʿriḍīna"]],[["كَأَنَّهُمۡ","ka-ʾannahum"],["حُمُرࣱ","ḥumurun"],["مُّسۡتَنفِرَةࣱ","mustanfiratun",{"0":"mustanfaratun","1":"mustanfaratun","6":"mustanfaratun","7":"mustanfaratun"}]],[["فَرَّتۡ","farrat"],["مِن","min"],["قَسۡوَرَةِۭ","qaswaratin"]],[["بَلۡ","bal"],["یُرِیدُ","yurīdu"],["كُلُّ","kullu"],["ٱمۡرِیࣲٕ","mriʾin"],["مِّنۡهُمۡ","minhum"],["أَن","ʾan"],["یُؤۡتَىٰ","